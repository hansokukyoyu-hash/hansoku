# ---- 基本設定(本番の値は README の手順で設定する) ----
APP_NAME="SNS閲覧数ダッシュボード"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tenpos.online/report
APP_TIMEZONE=Asia/Tokyo
APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
APP_FAKER_LOCALE=ja_JP

LOG_CHANNEL=daily
LOG_LEVEL=warning

# ---- データベース(お名前.com のコントロールパネルで作成した MySQL) ----
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=true
SESSION_PATH=/report
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log

# ---- ログイン(初回ログイン時に管理者として登録するGoogleアカウント。カンマ区切り) ----
ADMIN_EMAILS=

# ---- Google(ログイン と YouTube連携 で共用する OAuth クライアント) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Meta(Instagram・Facebookページ連携用アプリ) ----
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0

# ---- Threads(Threads連携用アプリ。Instagram・Facebook用とは別) ----
THREADS_APP_ID=
THREADS_APP_SECRET=

# ---- 収集の調整(通常は変更不要) ----
SNS_STORIES_INTERVAL_HOURS=2
SNS_DAILY_COLLECT_HOUR=3
SNS_ACCOUNTS_PER_RUN=3
SNS_REFRESH_POSTS_DAYS=90
SNS_FACEBOOK_POST_VIEWS_METRIC=post_media_view
